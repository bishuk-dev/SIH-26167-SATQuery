# Local development only. Copy to .env and adjust for the host environment.
SATQUERY_ENV=development
DATA_ROOT=./data
MODEL_ROOT=./models
DATABASE_URL=sqlite:///./data/satquery.db

# Phase 1 must set explicit upload/raster limits before enabling ingestion.
MAX_UPLOAD_SIZE_MB=
MAX_RASTER_PIXELS=

# CPU-only development remains supported when model inference is unavailable.
GPU_DEVICE=cpu
ENABLE_REMOTE_NETWORK=false
